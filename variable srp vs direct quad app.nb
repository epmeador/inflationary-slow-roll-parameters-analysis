  RowBox[{
   RowBox[{"\[Sigma]srOfN", "'"}], "[", "n", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dlam2dNsr", "[", "n_", "]"}], ":=", 
