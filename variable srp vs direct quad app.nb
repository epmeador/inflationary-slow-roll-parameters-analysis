Cell[CellGroupData[{
Cell["Find Slow-Roll Parameters from Deformed Quad Potential", "Title",
 CellChangeTimes->{{3.9641790422002163`*^9, 3.96417909496651*^9}, {
  3.990021261739787*^9, 3.9900212624709806`*^9}, {3.990021371509432*^9, 
  3.990021382030862*^9}},ExpressionUUID->"d92c9d5c-10ee-4d45-8344-\
82457fe41d79"],

Cell["\<\
The D-SRP code is outlined below and follows some of the steps mentioned in \
the excerpt above.\
\>", "Subtitle",
 CellChangeTimes->{{3.9641791250882673`*^9, 
  3.964179169682663*^9}},ExpressionUUID->"df9814ce-66a7-4c04-9449-\
00ace67f26d1"],

Cell["To start, let\[CloseCurlyQuote]s import the data D-SRP calculation in \
python.", "Text",
 CellChangeTimes->{{3.9641795893914948`*^9, 3.964179595933526*^9}, {
  3.964179636388582*^9, 3.96417966074114*^9}, {3.990021390493457*^9, 
  3.990021395735222*^9}},ExpressionUUID->"c5387b24-a3cb-4e7a-a5a6-\
64e46f49a459"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"data", "=", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\</Users/epmeador/Desktop/research/rwarthur/inflation_\
gravitywaves/inflation_code/Slow-Roll Parameters \
Tests/phi_H_V_N_clean_deformed_quad.csv\>\"", ",", "\"\<CSV\>\""}], "]"}]}], 
   ";"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"headers", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"numericalData", "=", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"2", ";;"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "These", " ", "are", " ", "the", " ", "variables", " ", "in", " ", "order",
     " ", "from", " ", "large", " ", "to", " ", "small", " ", "or", " ", 
    "rather", " ", "early", " ", "to", " ", "late", " ", "times"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]vals", "=", 
    RowBox[{"numericalData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"large", " ", "to", " ", "small"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Hvals", "=", 
    RowBox[{"numericalData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"large", " ", "to", " ", "small"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Vvals", "=", 
   RowBox[{"numericalData", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Nvals", "=", 
    RowBox[{"numericalData", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "I", " ", "am", " ", "going", " ", "to", " ", "reverse", " ", "the", " ", 
    "order", " ", "so", " ", "we", " ", "start", " ", "with", " ", "late", " ",
     "times", " ", 
    RowBox[{"(", 
     RowBox[{"N", "=", "0"}], ")"}], " ", "to", " ", "early", " ", "times"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Phi]vals", " ", "=", " ", 
    RowBox[{"Reverse", "[", "\[Phi]vals", "]"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vvals", " ", "=", " ", 
   RowBox[{"Reverse", "[", "Vvals", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hvals", " ", "=", " ", 
   RowBox[{"Reverse", "[", "Hvals", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Nvals", " ", "=", " ", 
    RowBox[{"Reverse", "[", "Nvals", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "epsilon", " ", "using", " ", "H", " ", "and", " ", 
    "derivative", " ", "of", " ", "H"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"HInterp", "=", 
  RowBox[{"Interpolation", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"\[Phi]vals", ",", "Hvals"}], "}"}], "]"}], ",", 
    RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epsdyn", "[", "\[Phi]_", "]"}], ":=", 
   RowBox[{"2", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"HInterp", "'"}], "[", "\[Phi]", "]"}], "/", 
       RowBox[{"HInterp", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epsvals", "=", 
    RowBox[{"epsdyn", "/@", "\[Phi]vals"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Let", "'"}], "s", " ", "take", " ", "a", " ", "look", " ", "at", 
    " ", "what", " ", "this", " ", "plot", " ", "appears", " ", "like"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pHphireal", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"\[Phi]vals", ",", "Hvals"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Phi]\>\"", ",", "\"\<H(\[Phi])\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Full Model: H(\[Phi])\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pVphireal", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"\[Phi]vals", ",", "Vvals"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Phi]\>\"", ",", "\"\<V(\[Phi])\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Full Model: V(\[Phi])\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pEpsphireal", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"\[Phi]vals", ",", "epsvals"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Green"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<\[Phi]\>\"", ",", "\"\<\[CurlyEpsilon](\\[\\Phi])\>\""}],
         "}"}]}], ",", 
      RowBox[{
      "PlotLabel", "->", "\"\<Full Model: \[CurlyEpsilon](\\[\\Phi])\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pHNreal", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"Nvals", ",", "Hvals"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<N\>\"", ",", "\"\<H(N)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Full Model: H(N)\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pVNreal", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"Nvals", ",", "Vvals"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<N\>\"", ",", "\"\<V(N)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Full Model: V(N)\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pEpsNreal", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"Nvals", ",", "epsvals"}], "}"}], "]"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Green"}], "}"}]}], ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<N\>\"", ",", "\"\<\[CurlyEpsilon](N)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Full Model: \[CurlyEpsilon](N)\>\""}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pHphireal", ",", "pHNreal"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"pVphireal", ",", "pVNreal"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"pEpsphireal", ",", "pEpsNreal"}], "}"}]}], "}"}], ",", 
   RowBox[{"Spacings", "->", 
    RowBox[{"{", 
     RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.96417968604653*^9, 3.964179727702344*^9}, {
