Cell[CellGroupData[{

Cell["Slow-Roll Parameters Calculation Tests", "Section",
 CellChangeTimes->{{3.964185226614355*^9, 3.964185297000063*^9}, {
  3.964188191220436*^9, 
  3.964188205502501*^9}},ExpressionUUID->"c895e0fc-e728-4a39-905c-\
4565e7e066ce"],

Cell["\<\
Let\[CloseCurlyQuote]s specifically examine the SRPs as functions of \[Phi], \
to do so we need to define the SRPs. We will do so use the slow-roll \
definition of H which comes from defining V(\[Phi]).\
\>", "Text",
 CellChangeTimes->{{3.964183285196116*^9, 3.964183354379999*^9}, {
  3.964183391625081*^9, 3.9641834064231653`*^9}, {3.9642775701498327`*^9, 
  3.964277577687367*^9}},ExpressionUUID->"50d6c15f-381a-4b08-b22d-\
7ea3ae2dbafc"],

Cell[CellGroupData[{

Cell[TextData[{
 "Test 1 - Semi-Analytic: Defining Slow-Roll Parameters from Potential where \
H(\[Phi]) = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "sr"], TraditionalForm]],ExpressionUUID->
  "7edeb0b2-d1dd-4ca8-8719-e0dba585c892"],
 " and SRPs come from Numerical Derivatives of  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "sr"], TraditionalForm]],ExpressionUUID->
  "4da13f3f-a183-4741-9dc3-f2d2dbf07c64"]
}], "Subsection",
 CellChangeTimes->{{3.964277590908722*^9, 3.964277634210985*^9}, {
  3.964277726548357*^9, 3.9642777867136793`*^9}, {3.965146581728839*^9, 
  3.965146584961206*^9}},ExpressionUUID->"9cc026d5-0f84-48d9-8b1b-\
b93090d1f9da"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"Below", " ", "should", " ", "give", " ", "V", 
    RowBox[{"(", "phi", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sampleVphi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"\[Phi]vals", ",", "Vvals"}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Interpolated", " ", "V", 
     RowBox[{"(", "phi", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VphiInterp", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"sampleVphi", ",", 
       RowBox[{"InterpolationOrder", "->", "5"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Vphi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{"VphiInterp", "[", "\[Phi]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Assuming", " ", "hubble", " ", "slow", " ", "roll", " ", "like", " ", 
     "I", " ", "said"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Hsr", "[", "\[Phi]_", "]"}], ":=", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"Vphi", "[", "\[Phi]", "]"}], "/", "3"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dHphi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Hsr", "'"}], "[", "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH2phi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Hsr", "''"}], "[", "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH3phi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "3", "]"}], "[", "Hsr", "]"}], "[", 
      "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH4phi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "4", "]"}], "[", "Hsr", "]"}], "[", 
      "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH5phi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "5", "]"}], "[", "Hsr", "]"}], "[", 
      "\[Phi]", "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Don", "'"}], "t", " ", "end", " ", "up", " ", "using", " ", 
     "derivatives", " ", "past", " ", "4", " ", "for", " ", "SRPs"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH6phi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "6", "]"}], "[", "Hsr", "]"}], "[", 
      "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH7phi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "7", "]"}], "[", "Hsr", "]"}], "[", 
      "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"dH8phi", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Derivative", "[", "8", "]"}], "[", "Hsr", "]"}], "[", 
      "\[Phi]", "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Slow", " ", "Roll", " ", "Parameters"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[CurlyEpsilon]sr", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{"2", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"dHphi", "[", "\[Phi]", "]"}], "/", 
         RowBox[{"Hsr", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Sigma]sr", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{"8", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"dH2phi", "[", "\[Phi]", "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", 
            RowBox[{"Hsr", "[", "\[Phi]", "]"}]}], ")"}]}], ")"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dHphi", "[", "\[Phi]", "]"}], "/", 
           RowBox[{"Hsr", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Higher", "-", 
     RowBox[{"order", " ", "slow"}], "-", 
     RowBox[{"roll", " ", "parameters"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]2sr", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "^", "2"}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"dHphi", "[", "\[Phi]", "]"}], "/", 
        RowBox[{
         RowBox[{"Hsr", "[", "\[Phi]", "]"}], "^", "2"}]}], ")"}], "*", " ", 
      RowBox[{"dH3phi", "[", "\[Phi]", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]3sr", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "^", "3"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"dHphi", "[", "\[Phi]", "]"}], "/", 
         RowBox[{"Hsr", "[", "\[Phi]", "]"}]}], ")"}], "^", "2"}], "*", 
      RowBox[{
       RowBox[{"dH4phi", "[", "\[Phi]", "]"}], "/", 
       RowBox[{
        RowBox[{"Hsr", "[", "\[Phi]", "]"}], "^", "3"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]4sr", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "^", "4"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dHphi", "[", "\[Phi]", "]"}], ")"}], "^", "3"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dH5phi", "[", "\[Phi]", "]"}], ")"}], "/", 
       RowBox[{
        RowBox[{"Hsr", "[", "\[Phi]", "]"}], "^", "5"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]5sr", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "^", "5"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dHphi", "[", "\[Phi]", "]"}], ")"}], "^", "4"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dH6phi", "[", "\[Phi]", "]"}], ")"}], "/", 
       RowBox[{
        RowBox[{"Hsr", "[", "\[Phi]", "]"}], "^", "6"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]6sr", "[", "\[Phi]_", "]"}], ":=", 
     RowBox[{
      RowBox[{"2", "^", "6"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dHphi", "[", "\[Phi]", "]"}], ")"}], "^", "5"}], "*", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dH7phi", "[", "\[Phi]", "]"}], ")"}], "/", 
       RowBox[{
        RowBox[{"Hsr", "[", "\[Phi]", "]"}], "^", "7"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.965146496627453*^9, 3.96514650308206*^9}, {
  3.9900219648730497`*^9, 3.990021970538371*^9}, {3.990022017775601*^9, 
  3.990022068489193*^9}, {3.990022136865492*^9, 3.990022137117093*^9}},
 CellLabel->"In[50]:=",ExpressionUUID->"4e161628-3c84-4f3f-8831-52e7b883f4f7"],

Cell["\<\
Below, I am finding slow-roll parameters using H as is defined by V and \
interpolated. It is evaluated below for \[Phi]inf values. In the case of the \
deformed quad model, it is already over the inflationary range so that is why \
I can just define it like so.\
\>", "Text",
 CellChangeTimes->{{3.96418367587477*^9, 3.964183740103982*^9}, {
  3.964184197660646*^9, 3.9641841987784224`*^9}, {3.9900222924799013`*^9, 
  3.990022311744801*^9}},ExpressionUUID->"abf5d804-8612-41a1-b9eb-\
5b4fa6905c7e"],

