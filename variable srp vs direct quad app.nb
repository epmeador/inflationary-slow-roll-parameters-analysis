f51f913c1e46"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "used", " ", "the", " ", "definition", " ", "below", " ", 
    "earlier", " ", "in", " ", "test", " ", "2", " ", "which", " ", "gives", " ",
     "us", " ", "\[Phi]", 
    RowBox[{"(", "N", ")"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"phiOfNInterpdyn", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"Ninf", ",", "\[Phi]inf"}], "}"}], "]"}], ",", 
       RowBox[{"InterpolationOrder", "->", "5"}]}], "]"}]}], ";", " ", 
    RowBox[{"(*", 
     RowBox[{
     "only", " ", "difference", " ", "is", " ", "changing", " ", "the", " ", 
      "interp", " ", "order"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"phiOfNdyn", "[", "n_", "]"}], ":=", 
     RowBox[{"phiOfNInterpdyn", "[", "n", "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"epsflowPhi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phiOfNdyn", "/@", "Ninf"}], ",", "epsflow"}], "}"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"sigflowPhi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phiOfNdyn", "/@", "Ninf"}], ",", "sigflow"}], "}"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"lam2flowPhi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phiOfNdyn", "/@", "Ninf"}], ",", "lam2flow"}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lam3flowPhi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phiOfNdyn", "/@", "Ninf"}], ",", "lam3flow"}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lam4flowPhi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phiOfNdyn", "/@", "Ninf"}], ",", "lam4flow"}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lam5flowPhi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phiOfNdyn", "/@", "Ninf"}], ",", "lam5flow"}], "}"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lam6flowPhi", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"phiOfNdyn", "/@", "Ninf"}], ",", "lam6flow"}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"epsflowInterpPhi", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"epsflowPhi", ",", 
        RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", "\n", 
     RowBox[{"sigflowInterpPhi", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"sigflowPhi", ",", 
        RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", "\n", 
     RowBox[{"lam2flowInterpPhi", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"lam2flowPhi", ",", 
        RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", "\n", 
     RowBox[{"lam3flowInterpPhi", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"lam3flowPhi", ",", 
        RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", "\n", 
     RowBox[{"lam4flowInterpPhi", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"lam4flowPhi", ",", 
        RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", "\n", 
     RowBox[{"lam5flowInterpPhi", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"lam5flowPhi", ",", 
        RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";", "\n", 
     RowBox[{"lam6flowInterpPhi", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"lam6flowPhi", ",", 
        RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pEpsflowphi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"epsflowPhi", ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[CurlyEpsilon]_flow(\[Phi])\>\""}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Black"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pSigflowphi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"sigflowPhi", ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[Sigma]_flow(\[Phi])\>\""}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pLam2flowphi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"lam2flowPhi", ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[Lambda]\:2082_flow(\[Phi])\>\""}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Red"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pLam3flowphi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"lam3flowPhi", ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[Lambda]\:2083_flow(\[Phi])\>\""}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Purple"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pLam4flowphi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"lam4flowPhi", ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[Lambda]\:2084_flow(\[Phi])\>\""}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Green"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pLam5flowphi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"lam5flowPhi", ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[Lambda]\:2085_flow(\[Phi])\>\""}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Orange"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"pLam6flowphi", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"lam6flowPhi", ",", 
       RowBox[{"PlotLabel", "->", "\"\<\[Lambda]\:2086_flow(\[Phi])\>\""}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Thick", ",", "Brown"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"GraphicsGrid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pEpsflowphi", ",", "pSigflowphi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"pLam2flowphi", ",", "pLam3flowphi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"pLam4flowphi", ",", "pLam5flowphi"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"pLam6flowphi", ",", "Null"}], "}"}]}], "}"}], ",", 
     RowBox[{"Spacings", "->", 
      RowBox[{"{", 
       RowBox[{"2", ",", "2"}], "}"}]}]}], "]"}], "\n", 
   "\[IndentingNewLine]"}]}]], "Input",
