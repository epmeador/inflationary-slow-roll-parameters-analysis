Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "HUBBLE", " ", "SLOW", " ", "ROLL", " ", "EXPECTED", " ", "OBSERVABLES"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[CurlyEpsilon]pivsr", "=", 
     RowBox[{"\[CurlyEpsilon]srOfN", "[", "Npiv", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]pivsr", "=", 
     RowBox[{"\[Sigma]srOfN", "[", "Npiv", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Lambda]2pivsr", "=", 
     RowBox[{"\[Lambda]2srOfN", "[", "Npiv", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]3pivsr", "=", 
     RowBox[{"\[Lambda]3OfNsr", "[", "Npiv", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Lambda]4pivsr", "=", 
     RowBox[{"\[Lambda]4OfNsr", "[", "Npiv", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]5pivsr", "=", 
     RowBox[{"\[Lambda]5OfNsr", "[", "Npiv", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Lambda]6pivsr", "=", 
     RowBox[{"\[Lambda]6OfNsr", "[", "Npiv", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"We", " ", "need", " ", "derivatives", " ", "at", " ", "Npiv"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d\[CurlyEpsilon]pivsr", "=", " ", 
     RowBox[{"depsdNsr", "[", "Npiv", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d\[Sigma]pivsr", "=", 
     RowBox[{"dsigmadNsr", "[", "Npiv", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d\[Lambda]2pivsr", "=", 
     RowBox[{"dlam2dNsr", "[", "Npiv", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhighsr", " ", "=", " ", 
     RowBox[{"16", "*", "\[CurlyEpsilon]pivsr", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"Const", "*", 
         RowBox[{"(", 
          RowBox[{"\[Sigma]pivsr", "+", 
           RowBox[{"2", "*", "\[CurlyEpsilon]pivsr"}]}], ")"}]}]}], ")"}]}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rlowsr", " ", "=", " ", 
     RowBox[{"16", "*", "\[CurlyEpsilon]pivsr"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nshighsr", " ", "=", " ", 
     RowBox[{"1", "+", "\[Sigma]pivsr", "-", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"5", "-", 
          RowBox[{"(", 
           RowBox[{"3", "*", "Const"}], ")"}]}], ")"}], "*", 
        RowBox[{"\[CurlyEpsilon]pivsr", "^", "2"}]}], ")"}], "-", 
      RowBox[{"(", 
       RowBox[{"0.25", "*", 
        RowBox[{"(", 
         RowBox[{"3", "-", 
          RowBox[{"(", 
           RowBox[{"5", "*", "Const"}], ")"}]}], ")"}], "*", "\[Sigma]pivsr", 
        "*", "\[CurlyEpsilon]pivsr"}], ")"}], "+", 
      RowBox[{"(", 
       RowBox[{"0.5", "*", 
        RowBox[{"(", 
         RowBox[{"3", "-", "Const"}], ")"}], "*", "\[Lambda]2pivsr"}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nslowsr", "=", " ", 
     RowBox[{"\[Sigma]pivsr", "+", "1"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Need", " ", "the", " ", 
     RowBox[{"dns", "/", "dN"}], " ", "parameter", " ", "for", " ", "the", " ",
      "running", " ", "spectral", " ", "index"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dnsdNsr", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{"d\[Sigma]pivsr", "-", 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{"5", "-", 
          RowBox[{"(", 
           RowBox[{"3", "*", "Const"}], ")"}]}], ")"}], "*", 
        "\[CurlyEpsilon]pivsr", "*", "d\[CurlyEpsilon]pivsr"}], "-", 
       RowBox[{"0.25", "*", 
        RowBox[{"(", 
         RowBox[{"3", "-", 
          RowBox[{"(", 
           RowBox[{"5", "*", "Const"}], ")"}]}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"d\[Sigma]pivsr", "*", "\[CurlyEpsilon]pivsr"}], "+", 
          RowBox[{"\[Sigma]pivsr", "*", "d\[CurlyEpsilon]pivsr"}]}], ")"}]}], 
       "+", 
       RowBox[{"0.5", "*", 
