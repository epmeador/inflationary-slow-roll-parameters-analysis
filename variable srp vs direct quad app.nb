    RowBox[{"\[Lambda]2srOfN", "'"}], "[", "n", "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "I", " ", "am", " ", "using", " ", "flow", " ", "equations", " ", "for", " ",
     "the", " ", "rest"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Lambda]3OfNsr", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"dlam2dNsr", "[", "n", "]"}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "2"}], ")"}], " ", 
