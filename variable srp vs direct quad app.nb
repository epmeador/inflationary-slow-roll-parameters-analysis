Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phiOfNInterpsr", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"Ninf", ",", "\[Phi]inf"}], "}"}], "]"}], ",", 
      RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "only", " ", "difference", " ", "is", " ", "changing", " ", "the", " ", 
    "interp", " ", "order"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
