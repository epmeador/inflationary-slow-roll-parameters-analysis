Cell[CellGroupData[{

Cell[TextData[{
 "Test 3: Full Flow -- Meaning I redefine \[CurlyEpsilon] (\[Phi]) using the \
full flow definitions using ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "inf"], TraditionalForm]],ExpressionUUID->
  "301bef37-3899-4618-b835-e90c5c258cd3"],
 " (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["N", "inf"], TraditionalForm]],ExpressionUUID->
  "970adc4d-6836-4d70-a0c2-4be7bfb34a61"],
 ") "
}], "Subsection",
 CellChangeTimes->{{3.96427847992188*^9, 3.964278483252102*^9}, {
   3.964279133284017*^9, 3.9642792096001663`*^9}, 
   3.964283274354653*^9},ExpressionUUID->"6550b58e-bd36-463a-b307-\
7b9244bf370b"],

Cell[TextData[{
 "The third method I am shooting for won\[CloseCurlyQuote]t use \[Phi](N) in \
the calculation at all and instead will only use the flow equations which \
again can be found in ",
 ButtonBox["this paper",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/pdf/astro-ph/0210345"], None},
  ButtonNote->"https://arxiv.org/pdf/astro-ph/0210345"],
 ". I only bring out \[Phi](N) so I can later compare it to Tests 1 & 2 which \
require \[CurlyEpsilon](\[Phi])."
}], "Text",
 CellChangeTimes->{{3.964616574892519*^9, 3.964616631095347*^9}, 
   3.964716442145406*^9},ExpressionUUID->"134b2390-1c8d-4eb9-920d-\
c8ff5f9b904c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"HInterpN", "=", 
   RowBox[{"Interpolation", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"Ninf", ",", "Hinf"}], "}"}], "]"}], ",", 
     RowBox[{"InterpolationOrder", "->", "3"}]}], "]"}]}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"HNvals", "=", 
