  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]5OfNsr", "[", "n_", "]"}], ":=", 
   RowBox[{
    RowBox[{"dlam4dNsr", "[", "n", "]"}], "-", 
