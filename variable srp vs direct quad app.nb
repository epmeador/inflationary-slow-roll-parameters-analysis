      RowBox[{"{", 
       RowBox[{"\[Phi]inf", ",", "Hinf"}], "}"}], "]"}], ",", 
     RowBox[{"InterpolationOrder", "->", "4"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
